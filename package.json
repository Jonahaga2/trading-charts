{
  "name": "trading-charts",
  "version": "3.0.0",
  "private": true,
  "description": "Multi-chart trading workspace built on TradingView's embedded charts.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "serve": "node tools/serve.mjs",
    "test": "node build.mjs --check",
    "test:backtest": "node backtest/engine.test.mjs && node backtest/strategy.test.mjs",
    "backtest": "node backtest/run.mjs",
    "scan": "node backtest/scan.mjs",
    "test:engine": "node archive/lightweight-engine/ta.test.mjs",
    "test:engine:data": "node archive/lightweight-engine/data.test.mjs",
    "shot": "node tools/cdp-shot.mjs http://localhost:8099/index.html .shots/chart.png 28000"
  },
  "engines": {
    "node": ">=18"
  }
}
