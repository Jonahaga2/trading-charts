{
  "name": "trading-charts",
  "version": "2.0.0",
  "private": true,
  "description": "Live trading charts — accurate candles, 41 verified indicators, session-aware VWAP and pivots.",
  "//": "Deliberately NOT type:module. src/*.js must stay CommonJS so the tests can require() them and the browser can inline them unchanged; every tool here is .mjs already.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "test": "node test/ta.test.mjs && node test/data.test.mjs",
    "test:ta": "node test/ta.test.mjs",
    "test:data": "node test/data.test.mjs",
    "test:fresh": "node test/ta.test.mjs && node test/data.test.mjs --fresh",
    "serve": "node -e \"import('node:http').then(async({default:h})=>{const{readFile}=await import('node:fs/promises');h.createServer(async(q,s)=>{try{const p=q.url==='/'?'/index.html':q.url.split('?')[0];const b=await readFile('.'+p);s.writeHead(200,{'content-type':p.endsWith('.html')?'text/html':'text/plain'});s.end(b)}catch{s.writeHead(404);s.end('not found')}}).listen(8099,()=>console.log('http://localhost:8099'))})\""
  },
  "engines": { "node": ">=18" }
}
