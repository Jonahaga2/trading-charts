{
  "name": "trading-charts",
  "version": "3.0.0",
  "private": true,
  "description": "Multi-chart trading workspace built on TradingView's embedded charts.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "serve": "node -e \"import('node:http').then(async({default:h})=>{const{readFile}=await import('node:fs/promises');h.createServer(async(q,s)=>{try{const p=q.url==='/'?'/index.html':q.url.split('?')[0];const b=await readFile('.'+p);s.writeHead(200,{'content-type':p.endsWith('.html')?'text/html':'text/plain'});s.end(b)}catch{s.writeHead(404);s.end('not found')}}).listen(8099,()=>console.log('http://localhost:8099'))})\"",
    "test": "node build.mjs --check",
    "test:engine": "node archive/lightweight-engine/ta.test.mjs",
    "test:engine:data": "node archive/lightweight-engine/data.test.mjs",
    "shot": "node tools/cdp-shot.mjs http://localhost:8099/index.html .shots/chart.png 28000"
  },
  "engines": {
    "node": ">=18"
  }
}
